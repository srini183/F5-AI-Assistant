BIGIP_HOST=https://your-bigip.example.com
BIGIP_USERNAME=admin
# Note: Wrap passwords with special characters (like # or $) in quotes!
BIGIP_PASSWORD="change-me"
BIGIP_VERIFY_SSL=false

# Backward-compatible BIG-IP aliases used if BIGIP_* is not set.
F5_HOST=
F5_USERNAME=
F5_PASSWORD=
F5_VERIFY_SSL=

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Optional only if you explicitly set AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
